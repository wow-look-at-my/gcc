+  gas_buf_in = NULL;
+  gas_buf_pos = 0;
+  gas_buf_len = 0;
 }
 
 /* Return BUFFER_SIZE.  */
@@ -122,6 +146,39 @@
 
   preprocess = pre;
 
+  if (gas_buf_mode)
+    {
+      /* In-memory buffer input.  Mirror the file path's leading-byte peek
+	 for #APP / #NO_APP so the scrubber behaves identically, but do not
+	 consume the bytes (gas_buf_pos stays at 0 so input_file_get re-reads
+	 them).  */
+      const char *p = gas_buf_in;
+      size_t avail = gas_buf_len;
+
+      file_name = _("<gas-embed>");
+
+      /* Empty input: nothing to do (mirrors the empty-file early return).  */
+      if (avail == 0)
+	return;
+
+      c = (unsigned char) p[0];
+      if (c == '#')
+	{
+	  /* Begins with comment, may not want to preprocess.  */
+	  if (avail >= 2 && p[1] == 'N')
+	    {
+	      if (avail >= 7 && startswith (p + 2, "O_APP") && ISSPACE (p[7]))
+		preprocess = 0;
+	    }
+	  else if (avail >= 2 && p[1] == 'A')
+	    {
+	      if (avail >= 4 && startswith (p + 2, "PP") && ISSPACE (p[4]))
+		preprocess = 1;
+	    }
+	}
+      return;
+    }
+
