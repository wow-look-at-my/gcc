 static FILE *f_in;
 static const char *file_name;
 
+/* In-memory buffer input (cc1plus embed mode).  When gas_buf_mode is set,
+   input is read from gas_buf_in[gas_buf_pos .. gas_buf_len) instead of f_in,
+   while still passing through the normal preprocess/do_scrub_chars path.  */
+static const char *gas_buf_in;
+static size_t gas_buf_pos;
+static size_t gas_buf_len;
+static int gas_buf_mode;
+
+/* Register an in-memory assembly buffer as the input source.  Must be called
+   before input_file_open (i.e. before read_a_source_file).  */
+
+void
+input_file_set_buffer (const char *buf, size_t len)
+{
+  gas_buf_in = buf;
+  gas_buf_pos = 0;
+  gas_buf_len = len;
+  gas_buf_mode = 1;
+}
+
